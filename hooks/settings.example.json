{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Agent|SubagentHandback", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/loop-event.py\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Agent|TaskStop", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/loop-event.py\"" } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/loop-event.py\"" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/loop-event.py\"" } ] }
    ]
  }
}
